include README.md CHANGELOG.md CONTRIBUTING.md LICENSE THIRD_PARTY_NOTICES.md
include package.json package-lock.json
recursive-include dash_text_annotate *.py *.min.js *.css *.json py.typed *.md
recursive-include src *.js *.mjs *.css
recursive-include scripts *.mjs *.py
recursive-include tests *.py *.mjs
prune node_modules
prune venv
prune .venv
global-exclude *wps-hmr* output.js *.pyc *.map
include usage.py PRODUCT.md DESIGN.md .nvmrc
recursive-include assets *.css
recursive-include docs *.md *.svg
# Demo recordings are documentation assets, not part of the plugin download.
recursive-exclude docs/media *.gif *.mp4
recursive-include licenses *.txt
